<!-- Clusters cache managers within a single JVM: LOCAL_PING only discovers members in the same JVM, and
     ephemeral loopback ports keep concurrent builds from colliding. -->
<config xmlns="urn:org:jgroups"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="urn:org:jgroups http://www.jgroups.org/schema/jgroups-5.3.xsd">
	<TCP bind_addr="127.0.0.1" bind_port="0" port_range="0" diag.enabled="false"/>
	<LOCAL_PING/>
	<MERGE3/>
	<pbcast.NAKACK2 use_mcast_xmit="false"/>
	<UNICAST3/>
	<pbcast.STABLE/>
	<pbcast.GMS print_local_addr="false" join_timeout="2s"/>
	<UFC/>
	<MFC/>
	<FRAG4/>
</config>
