<infinispan xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
            xsi:schemaLocation="urn:infinispan:config:15.2 https://infinispan.org/schemas/infinispan-config-15.2.xsd" 
            xmlns="urn:infinispan:config:15.2">
	<cache-container>
		<!-- Single-node/dev session store (cache.type=local); mirrors infinispan-api.xml. Spring
		     Session writes the whole session attribute map, so module code stashing Hibernate-managed
		     state in it (e.g. legacyui's portlet cache) needs the same module-side types admitted;
		     nothing crosses the wire here, so this is for parity with the clustered config rather than
		     protection. -->
		<serialization>
			<allow-list>
				<class>org.openmrs.api.context.SessionPrincipal</class>
				<regex>org\.springframework\.session\..*</regex>
				<regex>org\.openmrs\..*</regex>
				<regex>java\.sql\..*</regex>
				<regex>org\.hibernate\.collection\.spi\..*</regex>
				<regex>org\.hibernate\.proxy\..*</regex>
			</allow-list>
		</serialization>

		<local-cache name="sessions" statistics="false">
			<encoding media-type="application/x-java-serialized-object"/>
			<expiration lifespan="1800000" interval="60000"/>
			<memory max-count="50000"/>
		</local-cache>

		<local-cache-configuration name="entity" simple-cache="true" statistics="false">
			<encoding media-type="application/x-java-object"/>
			<transaction mode="NONE" />
			<expiration max-idle="100000" interval="5000"/>
			<memory max-count="10000"/>
		</local-cache-configuration>

		<!-- Like entity, but with a lifespan TTL: role/privilege eviction only fires on API mutations,
		     so the lifespan is a safety net that bounds staleness from role changes made outside the API. -->
		<local-cache-configuration name="role-privileges" simple-cache="true" statistics="false">
			<encoding media-type="application/x-java-object"/>
			<transaction mode="NONE" />
			<expiration lifespan="3600000" max-idle="100000" interval="5000"/>
			<memory max-count="10000"/>
		</local-cache-configuration>
		
		<local-cache-configuration name="concept-ids-by-mapping" simple-cache="true" statistics="false">
			<encoding media-type="application/x-java-object"/>
			<transaction mode="NONE"/>
			<expiration max-idle="-1" interval="5000"/>
			<memory max-count="10000"/>
		</local-cache-configuration>

		<local-cache-configuration name="user-search-locales" simple-cache="true" statistics="false">
			<encoding media-type="application/x-java-object"/>
			<transaction mode="NONE"/>
			<expiration max-idle="300000" lifespan="300000" interval="5000"/>
			<memory max-count="500"/>
		</local-cache-configuration>

		<!-- Like entity, but with a lifespan TTL: global property eviction only fires on API mutations,
		     so the lifespan is a safety net that bounds staleness from changes made outside the API. -->
		<local-cache-configuration name="global-properties" simple-cache="true" statistics="false">
			<encoding media-type="application/x-java-object"/>
			<transaction mode="NONE" />
			<expiration lifespan="3600000" interval="5000"/>
			<memory max-count="10000"/>
		</local-cache-configuration>

	</cache-container>
</infinispan>
