	<changeSet id="TRUNK-6738-add-obs_archive" author="shivvani-r">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="obs_archive"/>
			</not>
		</preConditions>
		<comment>Add obs_archive table for Archiving Observations</comment>
		<createTable tableName="obs_archive">
			<column name="obs_id" type="INT">
				<constraints nullable="false" primaryKey="true"/>
			</column>
			<column name="person_id" type="INT">
				<constraints nullable="false"/>
			</column>
			<column name="concept_id" type="INT">
				<constraints nullable="false"/>
			</column>
			<column name="encounter_id" type="INT"/>
			<column name="order_id" type="INT"/>
			<column name="obs_datetime" type="DATETIME">
				<constraints nullable="false"/>
			</column>
			<column name="location_id" type="INT"/>
			<column name="obs_group_id" type="INT"/>
			<column name="accession_number" type="VARCHAR(255)"/>
			<column name="value_group_id" type="INT"/>
			<column name="value_coded" type="INT"/>
			<column name="value_coded_name_id" type="INT"/>
			<column name="value_drug" type="INT"/>
			<column name="value_datetime" type="DATETIME"/>
			<column name="value_numeric" type="DOUBLE"/>
			<column name="value_modifier" type="VARCHAR(2)"/>
			<column name="value_text" type="TEXT"/>
			<column name="value_complex" type="VARCHAR(1000)"/>
			<column name="comments" type="VARCHAR(255)"/>
			<column name="creator" type="INT">
				<constraints nullable="false"/>
			</column>
			<column name="date_created" type="DATETIME">
				<constraints nullable="false"/>
			</column>
			<column name="voided" type="BOOLEAN" defaultValueBoolean="false">
				<constraints nullable="false"/>
			</column>
			<column name="voided_by" type="INT"/>
			<column name="date_voided" type="DATETIME"/>
			<column name="void_reason" type="VARCHAR(255)"/>
			<column name="uuid" type="CHAR(38)">
				<constraints nullable="false" unique="true"/>
			</column>
			<column name="previous_version" type="INT"/>
			<column name="form_namespace_and_path" type="VARCHAR(255)"/>
			<column defaultValue="FINAL" name="status" type="VARCHAR(16)">
				<constraints nullable="false"/>
			</column>
			<column name="interpretation" type="VARCHAR(32)"/>
			<column name="changed_by" type="INT"/>
			<column name="date_changed" type="DATETIME"/>
			<column name="archived_by" type="INT"/>
			<column name="date_archived" type="DATETIME"/>
		</createTable>
		
		<createIndex indexName="idx_obs_archive_obs_group_id" tableName="obs_archive">
			<column name="obs_group_id"/>
		</createIndex>
		<createIndex indexName="idx_obs_archive_encounter_id" tableName="obs_archive">
			<column name="encounter_id"/>
		</createIndex>
		<createIndex indexName="idx_obs_archive_date_voided" tableName="obs_archive">
			<column name="date_voided"/>
		</createIndex>
		<createIndex indexName="idx_obs_archive_person_id" tableName="obs_archive">
			<column name="person_id"/>
		</createIndex>
		<createIndex indexName="idx_obs_archive_concept_id" tableName="obs_archive">
			<column name="concept_id"/>
		</createIndex>

		<addForeignKeyConstraint constraintName="fk_obs_archive_person" baseTableName="obs_archive"
								 baseColumnNames="person_id" referencedTableName="person"
								 referencedColumnNames="person_id"/>
		<addForeignKeyConstraint constraintName="fk_obs_archive_concept" baseTableName="obs_archive"
								 baseColumnNames="concept_id" referencedTableName="concept"
								 referencedColumnNames="concept_id"/>
		<addForeignKeyConstraint constraintName="fk_obs_archive_encounter" baseTableName="obs_archive"
								 baseColumnNames="encounter_id" referencedTableName="encounter"
								 referencedColumnNames="encounter_id"/>
		<addForeignKeyConstraint constraintName="fk_obs_archive_location" baseTableName="obs_archive"
								 baseColumnNames="location_id" referencedTableName="location"
								 referencedColumnNames="location_id"/>
		<addForeignKeyConstraint constraintName="fk_obs_archive_order" baseTableName="obs_archive"
								 baseColumnNames="order_id" referencedTableName="orders"
								 referencedColumnNames="order_id"/>
		<addForeignKeyConstraint constraintName="fk_obs_archive_value_coded" baseTableName="obs_archive"
								 baseColumnNames="value_coded" referencedTableName="concept"
								 referencedColumnNames="concept_id"/>
		<addForeignKeyConstraint constraintName="fk_obs_archive_value_coded_name" baseTableName="obs_archive"
								 baseColumnNames="value_coded_name_id" referencedTableName="concept_name"
								 referencedColumnNames="concept_name_id"/>
		<addForeignKeyConstraint constraintName="fk_obs_archive_value_drug" baseTableName="obs_archive"
								 baseColumnNames="value_drug" referencedTableName="drug"
								 referencedColumnNames="drug_id"/>
		<addForeignKeyConstraint constraintName="fk_obs_archive_creator" baseTableName="obs_archive"
								 baseColumnNames="creator" referencedTableName="users" referencedColumnNames="user_id"/>
		<addForeignKeyConstraint constraintName="fk_obs_archive_voided_by" baseTableName="obs_archive"
								 baseColumnNames="voided_by" referencedTableName="users"
								 referencedColumnNames="user_id"/>
		<addForeignKeyConstraint constraintName="fk_obs_archive_changed_by" baseTableName="obs_archive"
								 baseColumnNames="changed_by" referencedTableName="users"
								 referencedColumnNames="user_id"/>
		<addForeignKeyConstraint constraintName="fk_obs_archive_archived_by" baseTableName="obs_archive"
								 baseColumnNames="archived_by" referencedTableName="users"
								 referencedColumnNames="user_id"/>
	</changeSet>

	<changeSet id="TRUNK-6738-add-obs_reference_range_archive" author="shivvani-r">
		<preConditions onFail="MARK_RAN">
			<not>
				<tableExists tableName="obs_reference_range_archive"/>
			</not>
		</preConditions>
	<comment>Add obs_reference_range_archive table for Archiving Observations</comment>
	<createTable tableName="obs_reference_range_archive">
		<column name="obs_reference_range_id" type="INT">
			<constraints nullable="false" primaryKey="true"/>
		</column>
		<column name="obs_id" type="INT">
			<constraints nullable="false" unique="true"/>
		</column>
		<column name="hi_absolute" type="DOUBLE"/>
		<column name="hi_critical" type="DOUBLE"/>
		<column name="hi_normal" type="DOUBLE"/>
		<column name="low_absolute" type="DOUBLE"/>
		<column name="low_critical" type="DOUBLE"/>
		<column name="low_normal" type="DOUBLE"/>
		<column name="uuid" type="CHAR(38)">
			<constraints nullable="false" unique="true"/>
		</column>
		<column name="archived_by" type="INT"/>
		<column name="date_archived" type="DATETIME"/>
	</createTable>
		<addForeignKeyConstraint constraintName="fk_obs_reference_range_archive_obs_id" baseTableName="obs_reference_range_archive" baseColumnNames="obs_id" referencedTableName="obs_archive" referencedColumnNames="obs_id"/>
		<addForeignKeyConstraint constraintName="fk_obs_reference_range_archive_archived_by" baseTableName="obs_reference_range_archive" baseColumnNames="archived_by"
								 referencedTableName="users" referencedColumnNames="user_id"/>
	</changeSet>

</databaseChangeLog>
